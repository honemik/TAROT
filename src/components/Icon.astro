---
import { Copy, ArrowUpRight, ChevronDown, ChevronLeft, ChevronRight, X, Shuffle, Undo2, Plus, Minus, Scan, Move, RotateCw, FlipHorizontal2, Expand, Layers, SlidersHorizontal, Maximize, Check, Sun, RotateCcw, Ellipsis, ArrowUp, ArrowDown, ArrowLeft, ArrowRight } from 'lucide';
const icons = { Copy, ArrowUpRight, ChevronDown, ChevronLeft, ChevronRight, X, Shuffle, Undo2, Plus, Minus, Scan, Move, RotateCw, FlipHorizontal2, Expand, Layers, SlidersHorizontal, Maximize, Check, Sun, RotateCcw, Ellipsis, ArrowUp, ArrowDown, ArrowLeft, ArrowRight };
interface Props { name: keyof typeof icons; size?: number }
const { name, size = 20 } = Astro.props;
const node = icons[name];
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{node[2]?.map(([Tag, attrs]) => <Tag {...attrs} />)}</svg>
